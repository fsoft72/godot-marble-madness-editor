extends TestCase
## Tests for BlockSurface (port of rotateUV and getBlockSurfaceY).

const GOLDEN_PATH := "res://tests/golden/surface_y.json"
const GOLDEN_EPS := 1e-4


## Loads the golden entries generated by tools/gen_golden.mjs.
func _load_golden() -> Array:
	var file := FileAccess.open(GOLDEN_PATH, FileAccess.READ)
	assert_true(file != null, "golden file opens")
	if file == null: return []
	var parsed: Variant = JSON.parse_string(file.get_as_text())
	assert_true(parsed is Array, "golden file is an array")
	if not parsed is Array: return []
	return parsed


## rotate_uv maps (u, v) like the JS rotateUV for every rotation, including wrapped ones.
func test_rotate_uv_all_rotations() -> void:
	assert_eq(BlockSurface.rotate_uv(1.0, 0.0, 0), Vector2(1, 0), "0")
	assert_eq(BlockSurface.rotate_uv(1.0, 0.0, 90), Vector2(3, 1), "90")
	assert_eq(BlockSurface.rotate_uv(1.0, 0.0, 180), Vector2(2, 3), "180")
	assert_eq(BlockSurface.rotate_uv(1.0, 0.0, 270), Vector2(0, 2), "270")
	assert_eq(BlockSurface.rotate_uv(1.0, 0.0, 360), Vector2(1, 0), "360")
	assert_eq(BlockSurface.rotate_uv(1.0, 0.0, -90), Vector2(0, 2), "-90 wraps to 270")
	assert_eq(BlockSurface.rotate_uv(1.0, 0.0, 450), Vector2(3, 1), "450 wraps to 90")
	assert_eq(BlockSurface.rotate_uv(1.0, 0.0, 45), Vector2(1, 0), "45 is identity")


## Every golden entry matches the JS result, including float rotations from JSON.
func test_surface_matches_golden() -> void:
	var golden := _load_golden()
	assert_true(golden.size() > 500, "golden has more than 500 entries")
	for entry in golden:
		var y := BlockSurface.surface_y(entry["block"], entry["u"], entry["v"])
		assert_near(y, entry["y"], GOLDEN_EPS, "block=%s u=%s v=%s" % [str(entry["block"]), entry["u"], entry["v"]])


## A flat block with no slope or tilt is at its elevation everywhere.
func test_flat_block_equals_elevation() -> void:
	var block := BlockData.make(0, 0, {"elevation": 7.0})
	for u in [0.0, 0.5, 1.5, 2.5, 3.0]:
		for v in [0.0, 0.5, 1.5, 2.5, 3.0]:
			assert_near(BlockSurface.surface_y(block, u, v), 7.0, GOLDEN_EPS, "flat at %s,%s" % [u, v])


## Integer and float rotations give the same height.
func test_int_and_float_rotation_agree() -> void:
	var a := BlockData.make(0, 0, {"slope": 1.0, "tilt": 0.5, "rotation": 90})
	var b := BlockData.make(0, 0, {"slope": 1.0, "tilt": 0.5, "rotation": 90.0})
	assert_near(BlockSurface.surface_y(a, 0.5, 2.5), BlockSurface.surface_y(b, 0.5, 2.5), 1e-9, "same height")


## A block without elevation behaves like the JS (undefined elevation is 0).
func test_missing_elevation_is_zero() -> void:
	assert_near(BlockSurface.surface_y({}, 1.0, 1.0), 0.0, GOLDEN_EPS, "empty block")
